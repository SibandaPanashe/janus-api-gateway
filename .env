# Janus Gateway - Environment Configuration
# Copy this file to .env and fill in production values
# DO NOT commit .env to version control

# PostgreSQL
POSTGRES_DB=janus
POSTGRES_USER=janus
POSTGRES_PASSWORD=janus-dev-password

# Redis (no auth configured yet - add for production)
# REDIS_PASSWORD=

# JWT Signing Secret (min 256 bits / 32 chars for HS256)
JANUS_JWT_SECRET=janus-dev-secret-change-in-production-min-256-bits

# Application environment
SPRING_PROFILES_ACTIVE=dev