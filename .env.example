# Janus Gateway - Environment Configuration Template
# Copy this to .env and fill in your values
# cp .env.example .env

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=janus
POSTGRES_USER=janus
POSTGRES_PASSWORD=change-me

# Redis
REDIS_HOST=localhost
REDIS_PORT=6380

# JWT Signing Secret (generate with: openssl rand -base64 32)
JANUS_JWT_SECRET=generate-a-random-secret-here
JANUS_JWT_ACCESS_TTL=3600000
JANUS_JWT_REFRESH_TTL=2592000000

# Server
SERVER_PORT=8080

# Observability
HEALTH_SHOW_DETAILS=when-authorized
LOG_LEVEL=INFO